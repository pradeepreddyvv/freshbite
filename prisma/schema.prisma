generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id                 String             @id @default(cuid())
  name               String
  address            String?
  city               String?
  state              String?
  country            String             @default("USA")
  timezone           String             @default("America/Los_Angeles")
  latitude           Float?
  longitude          Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  osmPlaceId         String?            @unique @map("osm_place_id")
  dishesAtRestaurant DishAtRestaurant[]

  @@index([city])
  @@index([name])
}

model Dish {
  id                 String             @id @default(cuid())
  name               String
  cuisine            String?
  description        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  dishesAtRestaurant DishAtRestaurant[]

  @@index([name])
}

model DishAtRestaurant {
  id           String              @id @default(cuid())
  restaurantId String
  dishId       String
  price        Float?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  alerts       AlertSubscription[]
  dish         Dish                @relation(fields: [dishId], references: [id], onDelete: Cascade)
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reviews      Review[]
  rollups      DailyRollup[]

  @@unique([restaurantId, dishId])
  @@index([restaurantId])
  @@index([dishId])
}

model Review {
  id                 String           @id @default(cuid())
  dishAtRestaurantId String
  rating             Int
  text               String
  createdAt          DateTime         @default(now())
  mealSlot           MealSlot?
  visitedAt          DateTime?
  dishAtRestaurant   DishAtRestaurant @relation(fields: [dishAtRestaurantId], references: [id], onDelete: Cascade)

  @@index([dishAtRestaurantId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([dishAtRestaurantId, createdAt(sort: Desc)], map: "Review_recent_combined_idx")
}

model AlertSubscription {
  id                 String           @id @default(cuid())
  dishAtRestaurantId String
  email              String?
  phone              String?
  window             String           @default("24h")
  minRating          Float            @default(3.0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  dishAtRestaurant   DishAtRestaurant @relation(fields: [dishAtRestaurantId], references: [id], onDelete: Cascade)

  @@index([dishAtRestaurantId])
  @@index([isActive])
}

model DailyRollup {
  id                 String           @id @default(cuid())
  dishAtRestaurantId String
  rollupDate         DateTime         @db.Date
  reviewCount        Int              @default(0)
  ratingSum          Int              @default(0)
  rating1Count       Int              @default(0) @map("rating_1_count")
  rating2Count       Int              @default(0) @map("rating_2_count")
  rating3Count       Int              @default(0) @map("rating_3_count")
  rating4Count       Int              @default(0) @map("rating_4_count")
  rating5Count       Int              @default(0) @map("rating_5_count")
  updatedAt          DateTime         @updatedAt
  dishAtRestaurant   DishAtRestaurant @relation(fields: [dishAtRestaurantId], references: [id], onDelete: Cascade)

  @@unique([dishAtRestaurantId, rollupDate])
  @@index([rollupDate])
  @@map("daily_rollup")
}

model RetentionConfig {
  id                 String   @id @default("singleton")
  keepRawDays        Int      @default(90)
  archiveEnabled     Boolean  @default(false)
  archiveDestination String   @default("none")
  warnAtPct          Float    @default(70.0)
  criticalAtPct      Float    @default(85.0)
  maxStorageMb       Float    @default(512.0)
  updatedAt          DateTime @updatedAt

  @@map("retention_config")
}

model DbHealthSnapshot {
  id             String   @id @default(cuid())
  totalSizeMb    Float
  tableSizesJson String
  indexSizesJson String
  usagePct       Float
  status         String
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("db_health_snapshot")
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  sessionId String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([path, createdAt(sort: Desc)])
  @@index([sessionId, path])
  @@map("page_visit")
}

model PageVisitCounter {
  path           String   @id
  totalViews     Int      @default(0)
  uniqueVisitors Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("page_visit_counter")
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  LATE_NIGHT
}
