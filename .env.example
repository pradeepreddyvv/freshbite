# ── Database (Supabase PostgreSQL) ──
DATABASE_URL="postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require&connect_timeout=15"

# ── Spring Boot JDBC (same DB, different format) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password

# ── Frontend → Backend API ──
# Local development:
BACKEND_URL=http://localhost:8080
# Production (set in Vercel dashboard):

# ── Spring Boot → Frontend (CORS) ──
WEB_ORIGIN=http://localhost:3000

# ── Spring Boot → FastAPI LLM Service ──
LLM_BASE_URL=http://localhost:8000

# ── Google Places API ──
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ── Redis (caching, optional — falls back gracefully) ──
REDIS_URL=redis://localhost:6379

# ── Kafka (review pipeline, optional — falls back to direct DB write) ──
KAFKA_BROKERS=localhost:9092
